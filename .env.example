# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings > API). Safe to expose to the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployed app, used in password-reset emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed script only (npm run seed). Do NOT add these to Vercel. ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=choose-a-long-password
MANAGER_NAME=Ashish Karambelkar

# --- Playwright end-to-end tests against a test project (optional) ---
# E2E_EMAIL=manager@example.com
# E2E_PASSWORD=...
